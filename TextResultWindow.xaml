<Window x:Class="Snapshot.TextResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot 文字识别"
        Width="780"
        Height="610"
        MinWidth="660"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="ResultCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E5E9ED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="CompactButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="92"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="72"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#17202A">
      <Grid Margin="26,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="正在识别文字"
                     FontSize="22" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="SubtitleText" Text="OCR 在本机完成，不会上传图片"
                     Margin="0,5,0,0" FontSize="12" Foreground="#B9C1C9"/>
        </StackPanel>
        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                Background="#263442" VerticalAlignment="Center">
          <TextBlock Text="文" FontSize="17" Foreground="#07C160"
                     FontWeight="Bold" HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="26,22">
        <Border Style="{StaticResource ResultCard}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <TextBlock Text="识别结果" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="LanguageText" Margin="0,0,12,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="复制" Style="{StaticResource CompactButton}"
                        Click="CopySource_Click"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="SourceTextBox"
                     MinHeight="145"
                     MaxHeight="260"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"/>
          </StackPanel>
        </Border>

        <Border x:Name="TranslationCard" Style="{StaticResource ResultCard}"
                Margin="0,16,0,0" Visibility="Collapsed">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <TextBlock Text="翻译结果" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TargetLanguageText" Margin="0,0,12,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="复制" Style="{StaticResource CompactButton}"
                        Click="CopyTranslation_Click"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="TranslationTextBox"
                     MinHeight="145"
                     MaxHeight="260"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"/>
            <TextBlock x:Name="TranslationStatusText" Margin="2,10,2,0"
                       FontSize="12" Foreground="#D14343"
                       TextWrapping="Wrap"/>
            <Button x:Name="OpenSettingsButton" Content="打开翻译设置"
                    Style="{StaticResource CompactButton}"
                    HorizontalAlignment="Left" Margin="0,10,0,0"
                    Visibility="Collapsed" Click="OpenSettings_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="#E5E9ED"
            BorderThickness="0,1,0,0">
      <Grid Margin="26,14">
        <TextBlock x:Name="FooterStatusText" Text="正在读取截图…"
                   VerticalAlignment="Center" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <Button Content="关闭" HorizontalAlignment="Right"
                Click="Close_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
