<Window x:Class="Snapshot.TranslationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot 图片翻译"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#11171D"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="PreviewButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
    <Style x:Key="PrimaryPreviewButton" TargetType="Button"
           BasedOn="{StaticResource PreviewButton}">
      <Setter Property="Background" Value="#07C160"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="88"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="74"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#17202A" BorderBrush="#2D3944"
            BorderThickness="0,0,0,1">
      <Grid Margin="28,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="图片翻译完成" Foreground="White"
                     FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubtitleText" Margin="0,5,0,0"
                     Foreground="#B9C1C9" FontSize="12"/>
        </StackPanel>
        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                Background="#263442" VerticalAlignment="Center">
          <TextBlock Text="译" Foreground="#07C160" FontSize="17"
                     FontWeight="Bold" HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="22" CornerRadius="10"
            BorderBrush="#34414D" BorderThickness="1"
            Background="#0B1015" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False">
        <Grid MinWidth="620" MinHeight="340">
          <Image x:Name="PreviewImage"
                 Margin="20"
                 Stretch="None"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Background="#17202A" BorderBrush="#2D3944"
            BorderThickness="0,1,0,0">
      <Grid Margin="28,14">
        <TextBlock x:Name="StatusText" Foreground="#B9C1C9"
                   FontSize="12" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,340,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="复制图片" Style="{StaticResource PrimaryPreviewButton}"
                  Click="CopyImage_Click"/>
          <Button Content="保存 JPG" Style="{StaticResource PreviewButton}"
                  Click="SaveImage_Click"/>
          <Button Content="关闭" Style="{StaticResource PreviewButton}"
                  Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
