<Window x:Class="Snapshot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot 设置"
        Width="660"
        Height="760"
        MinWidth="620"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI"
        Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E5E9ED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="104"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="116"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="78"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#17202A">
      <Grid Margin="28,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="14"
                Background="{StaticResource AccentBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Center">
          <Grid>
            <Path Stroke="White" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 17,11 L 11,11 L 11,17 M 35,17 L 35,11 L 29,11 M 17,35 L 11,35 L 11,29 M 29,35 L 35,35 L 35,29"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Snapshot" Foreground="White"
                     FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="按下快捷键，选择窗口或自由区域"
                     Foreground="#B9C1C9" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,22,28,18">
        <TextBlock Text="全局快捷键" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="复制到剪贴板" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="选区完成后直接粘贴" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <TextBox x:Name="ClipboardHotkeyBox" Grid.Column="1"
                       Tag="Clipboard"
                       IsReadOnly="True"
                       Cursor="Hand"
                       ToolTip="单击后按下新的快捷键"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"/>
            </Grid>
            <Border Height="1" Background="#EEF0F2" Margin="0,0,0,16"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="保存 JPG" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="选区完成后直接写入本地" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <TextBox x:Name="SaveHotkeyBox" Grid.Column="1"
                       Tag="Save"
                       IsReadOnly="True"
                       Cursor="Hand"
                       ToolTip="单击后按下新的快捷键"
                       PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                       GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="文件保存" Style="{StaticResource SectionLabel}" Margin="2,20,0,8"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="保存目录" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="默认使用 Windows 的“下载”文件夹" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="88"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SaveDirectoryBox" Margin="0,0,10,0"/>
              <Button Grid.Column="1" Content="浏览…" Click="Browse_Click"/>
            </Grid>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="JPG 质量" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="质量越高，文件越大" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Slider x:Name="QualitySlider" Grid.Column="1"
                      Minimum="60" Maximum="100" TickFrequency="1"
                      IsSnapToTickEnabled="True" VerticalAlignment="Center"
                      ValueChanged="QualitySlider_ValueChanged"/>
              <TextBlock x:Name="QualityValue" Grid.Column="2"
                         FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="OCR 与图片翻译" Style="{StaticResource SectionLabel}" Margin="2,20,0,8"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="OCR 识别语言" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="来自已安装的 Windows 语言包" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <ComboBox x:Name="OcrLanguageCombo" Grid.Column="1"
                        MinHeight="38" Padding="10,7"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="LanguageTag"/>
            </Grid>

            <Border Height="1" Background="#EEF0F2" Margin="0,16"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="翻译目标语言" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="译文将覆盖回图片中的原文字位置" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <ComboBox x:Name="TranslationTargetCombo" Grid.Column="1"
                        MinHeight="38" Padding="10,7"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Tag"/>
            </Grid>

            <TextBlock Text="Microsoft Translator 密钥" FontSize="13"
                       FontWeight="SemiBold" Margin="0,18,0,7"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <PasswordBox x:Name="TranslatorKeyBox"
                         Padding="12,9" MinHeight="38"
                         BorderBrush="#D9DEE3" BorderThickness="1"/>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="服务地址" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                <TextBox x:Name="TranslatorEndpointBox"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="区域（可选）" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                <TextBox x:Name="TranslatorRegionBox"/>
              </StackPanel>
            </Grid>

            <Border Background="#F2F8F5" CornerRadius="8" Padding="12"
                    Margin="0,14,0,0">
              <TextBlock FontSize="12" Foreground="#3C6251" TextWrapping="Wrap">
                <Run Text="隐私说明：OCR 完全在本机运行；使用翻译时，只有识别后的文字会发送给 Microsoft Translator。密钥使用当前 Windows 账户加密保存。"/>
              </TextBlock>
            </Border>
          </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   MinHeight="22"
                   Margin="4,14,4,0"
                   FontSize="12"
                   Foreground="#D14343"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="#E5E9ED" BorderThickness="0,1,0,0">
      <Grid Margin="28,15">
        <Button Content="恢复默认" HorizontalAlignment="Left"
                Click="RestoreDefaults_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Margin="0,0,10,0" Click="Cancel_Click"/>
          <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                  Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
